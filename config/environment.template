# انسخ القيم إلى أسرار الاستضافة أو إلى ملف البيئة المحلي الخاص بك، ثم استبدل الأمثلة.
NODE_ENV=production
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DB_NAME
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# بيانات المالك الأولية الخاصة ببيئتك الجديدة.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-strong-initial-password

# التخزين الخارجي المتوافق مع S3.
S3_ENDPOINT=https://s3.example.com
S3_REGION=auto
S3_BUCKET=wajbat-plus-files
S3_ACCESS_KEY_ID=replace-with-s3-access-key
S3_SECRET_ACCESS_KEY=replace-with-s3-secret-key
S3_PUBLIC_BASE_URL=https://cdn.example.com

